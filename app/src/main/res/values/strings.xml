    <!-- Settings: targeting -->
    <string name="setting_target_apps">Target apps</string>
    <string name="setting_target_apps_summary">Choose which apps receive the fake location</string>
    <string name="setting_spoof_all">Spoof every app in scope</string>
    <string name="setting_spoof_all_summary">When on, every app the framework loads the module into gets the fake location. Turn off to use the target apps list instead.</string>

    <!-- Settings: wifi -->
    <string name="setting_wifi_identity">Spoof Wi\u2011Fi identity</string>
    <string name="setting_wifi_identity_summary">Reports a fake access point. Wi\u2011Fi is a common cross\u2011check against GPS: a spoofed position next to your real network is easy to spot.</string>
    <string name="setting_wifi_ssid">Network name (SSID)</string>
    <string name="setting_wifi_bssid">Network address (BSSID)</string>
    <string name="setting_wifi_rssi">Signal strength (dBm)</string>

    <!-- Settings: advanced -->
    <string name="setting_fake_gnss">Fake satellite data</string>
    <string name="setting_fake_gnss_summary">Reports a made\u2011up but plausible set of satellites matching the fake position. Without this an app can notice that a valid fix arrived with no satellites behind it.</string>
    <string name="setting_block_geofence">Block geofences</string>
    <string name="setting_block_geofence_summary">Stops apps registering location\u2011triggered alerts that would fire on your real position.</string>
    <string name="setting_hide_toast">Hide \"spoofing active\" message</string>
    <string name="setting_hide_toast_summary">By default a short message appears inside each hooked app confirming the module is working. Turn on to hide it.</string>
    <string name="setting_broadcast">Allow external control</string>
    <string name="setting_broadcast_summary">Lets other apps and ADB start, stop and set the location by broadcast. Off by default. Once on, any app on this device that knows the command can move your location.</string>
    <string name="setting_verbose_log">Detailed logging</string>
    <string name="setting_verbose_log_summary">Logs every faked position. Useful for diagnosing, very noisy otherwise.</string>
    <string name="setting_language">Language</string>

    <!-- System hooks warning -->
    <string name="system_hooks_warning_title">Turn on system\u2011level hooks?</string>
    <string name="system_hooks_warning_message">This changes your location at the source, so every app on the phone sees it \u2014 including apps that check whether they are being hooked.

It is also the riskiest option. If something goes wrong, your phone\u2019s interface restarts: the screen goes black, you see the boot animation, and it returns after about 30 seconds. You will not lose any data, but it can happen without warning.

If that starts happening, turn this switch back off, or remove System Framework from the module\u2019s scope in LSPosed.

A reboot is needed for this to take effect.</string>
    <string name="system_hooks_warning_confirm">Turn it on</string>

