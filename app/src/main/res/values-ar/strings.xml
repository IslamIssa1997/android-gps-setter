    <string name="setting_horizontal_accuracy_summary">مدى الدقة التي يدّعيها الموقع المُبلَّغ عنه، بالأمتار.</string>
    <string name="setting_vertical_accuracy">الدقة الرأسية</string>
    <string name="setting_vertical_accuracy_summary">دقة قيمة الارتفاع المُبلَّغ عنها، بالأمتار. عند الإيقاف تبقى القيمة الأصلية.</string>

    <!-- الارتفاع -->
    <string name="setting_altitude">الارتفاع</string>
    <string name="setting_altitude_summary">الارتفاع فوق المجسم المرجعي، بالأمتار. كان يُبلَّغ عنه دائمًا بالقيمة صفر، وهي علامة واضحة على التزييف.</string>
    <string name="setting_msl">الارتفاع فوق سطح البحر</string>
    <string name="setting_msl_summary">الارتفاع فوق متوسط مستوى سطح البحر، بالأمتار. يعمل على أندرويد 14 فأحدث فقط.</string>
    <string name="setting_msl_accuracy">دقة الارتفاع فوق سطح البحر</string>
    <string name="setting_msl_accuracy_summary">دقة قيمة الارتفاع فوق سطح البحر، بالأمتار.</string>

    <!-- الحركة -->
    <string name="setting_speed">السرعة</string>
    <string name="setting_speed_summary">السرعة المُبلَّغ عنها أثناء ثبات الموقع، بالكيلومتر في الساعة. أما أثناء تحريك الموقع عبر مسار أو عصا التحكم فتُستخدم السرعة الفعلية المحسوبة.</string>
    <string name="setting_speed_accuracy">دقة السرعة</string>
    <string name="setting_speed_accuracy_summary">دقة قيمة السرعة المُبلَّغ عنها، بالكيلومتر في الساعة.</string>

