    <!-- إعدادات متقدمة -->
    <string name="setting_fake_gnss">بيانات أقمار صناعية مزيّفة</string>
    <string name="setting_fake_gnss_summary">يُبلِّغ عن مجموعة أقمار صناعية مُختلَقة لكنها منطقية وتطابق الموقع المزيّف. بدون ذلك قد يلاحظ التطبيق وصول موقع صالح دون أي أقمار صناعية خلفه.</string>
    <string name="setting_block_geofence">حظر السياجات الجغرافية</string>
    <string name="setting_block_geofence_summary">يمنع التطبيقات من تسجيل تنبيهات مرتبطة بالموقع قد تُفعَّل عند موقعك الحقيقي.</string>
    <string name="setting_hide_toast">إخفاء رسالة \"التزييف مُفعّل\"</string>
    <string name="setting_hide_toast_summary">تظهر افتراضيًا رسالة قصيرة داخل كل تطبيق معترَض تؤكد عمل الوحدة. فعّل هذا الخيار لإخفائها.</string>
    <string name="setting_broadcast">السماح بالتحكم الخارجي</string>
    <string name="setting_broadcast_summary">يتيح للتطبيقات الأخرى ولـ ADB بدء التزييف وإيقافه وتعيين الموقع عبر البث. معطّل افتراضيًا. عند تفعيله يمكن لأي تطبيق على الجهاز يعرف الأمر أن يغيّر موقعك.</string>
    <string name="setting_verbose_log">سجلّات تفصيلية</string>
    <string name="setting_verbose_log_summary">يسجّل كل موقع مزيّف. مفيد للتشخيص، لكنه كثير الضجيج.</string>
